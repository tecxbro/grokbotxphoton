{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_:+.@/-]+$"
    },
    "contextId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_:+.@/-]+$"
    },
    "operation": {
      "type": "string",
      "const": "app.sendCustomized"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "space": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_:+.@/-]+$"
            },
            "scope": {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                },
                "provider": {
                  "type": "string",
                  "const": "imessage"
                },
                "accountId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                },
                "lineId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                },
                "spaceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                }
              },
              "required": [
                "projectId",
                "provider",
                "accountId",
                "lineId",
                "spaceId"
              ],
              "additionalProperties": false
            },
            "kind": {
              "type": "string",
              "const": "space"
            }
          },
          "required": [
            "version",
            "id",
            "scope",
            "kind"
          ],
          "additionalProperties": false
        },
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/"
        },
        "layout": {
          "type": "object",
          "properties": {
            "caption": {
              "type": "string",
              "maxLength": 300
            },
            "subcaption": {
              "type": "string",
              "maxLength": 300
            },
            "image": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "stagingId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "mimeType": {
                      "type": "string",
                      "maxLength": 100,
                      "pattern": "^[a-z0-9.+-]+\\/[a-z0-9.+-]+$"
                    },
                    "bytes": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 26214400
                    }
                  },
                  "required": [
                    "stagingId",
                    "sha256",
                    "mimeType",
                    "bytes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "number",
                      "const": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                    },
                    "scope": {
                      "type": "object",
                      "properties": {
                        "projectId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                        },
                        "provider": {
                          "type": "string",
                          "const": "imessage"
                        },
                        "accountId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                        },
                        "lineId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                        },
                        "spaceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                        }
                      },
                      "required": [
                        "projectId",
                        "provider",
                        "accountId",
                        "lineId",
                        "spaceId"
                      ],
                      "additionalProperties": false
                    },
                    "kind": {
                      "type": "string",
                      "const": "attachment"
                    },
                    "messageId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                    }
                  },
                  "required": [
                    "version",
                    "id",
                    "scope",
                    "kind",
                    "messageId"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "caption"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "space",
        "templateId",
        "url",
        "layout"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "idempotencyKey",
    "contextId",
    "operation",
    "arguments"
  ],
  "additionalProperties": false
}
